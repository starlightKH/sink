{
  "manifest_version": 3,
  "name": "Laftel Sync Controller",
  "description": "Synchronize Laftel video playback between browsers.",
  "version": "1.0.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://laftel.net/*",
    "https://*.laftel.net/*",
    "http://laftel.net/*",
    "http://*.laftel.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Laftel Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://laftel.net/*",
        "https://*.laftel.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
